-- Блок очистки структуры (DROP TABLE CASCADE)
DROP TABLE IF EXISTS Enrollment CASCADE;
DROP TABLE IF EXISTS Course CASCADE;
DROP TABLE IF EXISTS Document CASCADE;
DROP TABLE IF EXISTS Application CASCADE;
DROP TABLE IF EXISTS Program CASCADE;
DROP TABLE IF EXISTS Student CASCADE;
DROP TABLE IF EXISTS University CASCADE;
DROP TABLE IF EXISTS Country CASCADE;

-- PART 4. DATABASE CREATION / Создание таблиц (CREATE TABLE)
CREATE TABLE Country (
    country_id SERIAL PRIMARY KEY,
    country_name VARCHAR(100) NOT NULL UNIQUE,
    continent VARCHAR(50) NOT NULL
);

CREATE TABLE University (
    university_id SERIAL PRIMARY KEY,
    country_id INT NOT NULL,
    university_name VARCHAR(150) NOT NULL,
    ranking INT CHECK (ranking > 0),
    FOREIGN KEY (country_id) REFERENCES Country(country_id) ON DELETE CASCADE
);

CREATE TABLE Student (
    student_id SERIAL PRIMARY KEY,
    home_university_id INT NOT NULL,
    first_name VARCHAR(100) NOT NULL,
    last_name VARCHAR(100) NOT NULL,
    email VARCHAR(100) NOT NULL UNIQUE,
    gpa NUMERIC(3, 2) CHECK (gpa >= 0.0 AND gpa <= 4.0),
    FOREIGN KEY (home_university_id) REFERENCES University(university_id) ON DELETE CASCADE
);

CREATE TABLE Program (
    program_id SERIAL PRIMARY KEY,
    host_university_id INT NOT NULL,
    program_name VARCHAR(150) NOT NULL,
    semester VARCHAR(20) NOT NULL,
    max_capacity INT CHECK (max_capacity > 0),
    FOREIGN KEY (host_university_id) REFERENCES University(university_id) ON DELETE CASCADE
);

CREATE TABLE Application (
    application_id SERIAL PRIMARY KEY,
    student_id INT NOT NULL,
    program_id INT NOT NULL,
    status VARCHAR(20) DEFAULT 'Pending' CHECK (status IN ('Pending', 'Approved', 'Rejected')),
    application_date DATE NOT NULL,
    FOREIGN KEY (student_id) REFERENCES Student(student_id) ON DELETE CASCADE,
    FOREIGN KEY (program_id) REFERENCES Program(program_id) ON DELETE CASCADE,
    UNIQUE (student_id, program_id)
);

CREATE TABLE Document (
    document_id SERIAL PRIMARY KEY,
    application_id INT NOT NULL UNIQUE,
    passport_copy BOOLEAN DEFAULT FALSE,
    motivation_letter BOOLEAN DEFAULT FALSE,
    FOREIGN KEY (application_id) REFERENCES Application(application_id) ON DELETE CASCADE
);

CREATE TABLE Course (
    course_id SERIAL PRIMARY KEY,
    program_id INT NOT NULL,
    course_title VARCHAR(150) NOT NULL,
    credits INT CHECK (credits > 0 AND credits <= 10),
    FOREIGN KEY (program_id) REFERENCES Program(program_id) ON DELETE CASCADE
);

CREATE TABLE Enrollment (
    enrollment_id SERIAL PRIMARY KEY,
    student_id INT NOT NULL,
    course_id INT NOT NULL,
    grade INT CHECK (grade >= 0 AND grade <= 100),
    FOREIGN KEY (student_id) REFERENCES Student(student_id) ON DELETE CASCADE,
    FOREIGN KEY (course_id) REFERENCES Course(course_id) ON DELETE CASCADE,
    UNIQUE (student_id, course_id)
);

