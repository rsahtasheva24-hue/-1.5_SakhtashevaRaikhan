UPDATE Student
SET home_university_id = 5
WHERE student_id = 1;

-- PART 7. SQL QUERIES (15 разных запросов)

-- 1. Selecting all records
SELECT * FROM Student;

-- 2. Selecting specific columns
SELECT first_name, last_name, email FROM Student;

-- 3. Filtering records using WHERE
SELECT * FROM Program WHERE semester = 'Fall 2026';

-- 4. Sorting using ORDER BY
SELECT * FROM University ORDER BY ranking ASC;

-- 5. Using LIKE
SELECT * FROM Student WHERE email LIKE '%@harvard.edu';

-- 6. Using BETWEEN
SELECT * FROM Enrollment WHERE grade BETWEEN 85 AND 100;

-- 7. Using IN
SELECT * FROM Country WHERE continent IN ('Europe', 'Asia');

-- 8. Aggregate functions (COUNT, SUM, AVG)
SELECT COUNT(*) AS total_students FROM Student;
SELECT SUM(credits) AS total_credits FROM Course;
SELECT AVG(gpa) AS average_gpa FROM Student;

-- 9. GROUP BY
SELECT status, COUNT(*) AS application_count 
FROM Application 
GROUP BY status;

-- 10. HAVING
SELECT program_id, COUNT(*) AS course_count 
FROM Course 
GROUP BY program_id 
HAVING COUNT(*) > 1;

-- 11. INNER JOIN
SELECT s.first_name, s.last_name, u.university_name 
FROM Student s 
INNER JOIN University u ON s.home_university_id = u.university_id;

-- 12. LEFT JOIN
SELECT s.first_name, a.status 
FROM Student s 
LEFT JOIN Application a ON s.student_id = a.student_id;

-- 13. Multiple-table joins
SELECT s.first_name, c.course_title, e.grade 
FROM Student s
JOIN Enrollment e ON s.student_id = e.student_id
JOIN Course c ON e.course_id = c.course_id;

-- 14. Subquery (Подзапрос IN)
SELECT course_title FROM Course 
WHERE program_id IN (SELECT program_id FROM Application WHERE status = 'Approved');

-- 15. Complex analytical query (Сложный запрос со всеми элементами)
SELECT u.university_name, COUNT(a.application_id) AS total_applications, AVG(s.gpa) AS avg_applicant_gpa
FROM University u
JOIN Student s ON u.university_id = s.home_university_id
JOIN Application a ON s.student_id = a.student_id
WHERE a.status = 'Approved'
GROUP BY u.university_name
ORDER BY total_applications DESC;

-- PART 9. VIEWS / Создание 2 представлений
-- Представление 1: Сводка успеваемости студентов (participant performance overview)
CREATE VIEW StudentPerformanceOverview AS
SELECT s.first_name, s.last_name, c.course_title, e.grade
FROM Student s
JOIN Enrollment e ON s.student_id = e.student_id
JOIN Course c ON e.course_id = c.course_id;

-- Представление 2: Статистика заявок по программам (competition statistics / program statistics)
CREATE VIEW ProgramApplicationStats AS
SELECT p.program_name, COUNT(a.application_id) AS total_applications, 
       SUM(CASE WHEN a.status = 'Approved' THEN 1 ELSE 0 END) AS approved_count
FROM Program p
LEFT JOIN Application a ON p.program_id = a.program_id
GROUP BY p.program_name;

-- PART 8. DATA ANALYSIS / 5 сложных аналитических бизнес-запросов

-- Вопрос 1: Какие университеты отправляют больше всего студентов по обмену? (Which universities have the highest number of participants?)
SELECT u.university_name, COUNT(s.student_id) AS sent_students
FROM University u
JOIN Student s ON u.university_id = s.home_university_id
GROUP BY u.university_name
ORDER BY sent_students DESC;

-- Вопрос 2: Какой средний балл (GPA) у студентов из каждой страны? (Performance report)
SELECT c.country_name, AVG(s.gpa) AS average_gpa
FROM Country c
JOIN University u ON c.country_id = u.country_id
JOIN Student s ON u.university_id = s.home_university_id
GROUP BY c.country_name;

-- Вопрос 3: Какие курсы имеют самые высокие средние оценки? (Which subjects have the highest average scores?)
SELECT c.course_title, AVG(e.grade) AS average_grade
FROM Course c
JOIN Enrollment e ON c.course_id = e.course_id
GROUP BY c.course_title
ORDER BY average_grade DESC;

-- Вопрос 4: Сколько заявок получило статус Approved в каждом семестре? 
SELECT p.semester, COUNT(a.application_id) AS approved_applications
FROM Program p
JOIN Application a ON p.program_id = a.program_id
WHERE a.status = 'Approved'
GROUP BY p.semester;

-- Вопрос 5: У каких студентов не хватает документов для одобрения заявки? (Missing documents analysis)
SELECT s.first_name, s.last_name, p.program_name
FROM Student s
JOIN Application a ON s.student_id = a.student_id
JOIN Program p ON a.program_id = p.program_id
JOIN Document d ON a.application_id = d.application_id
WHERE (d.passport_copy = FALSE OR d.motivation_letter = FALSE) AND a.status = 'Pending';
